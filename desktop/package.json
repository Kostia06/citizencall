{
  "name": "understudy-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "macOS Spotlight-style overlay around ui/'s /spotlight route (SPEC.md §3)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:prod": "UNDERSTUDY_URL=https://citizencall.dev/spotlight electron .",
    "dev": "node ./wait-for-ui.mjs && electron .",
    "dist": "electron-packager . CitizenCall --platform=darwin --arch=arm64 --overwrite --out=dist --ignore=\"^/dist($|/)\" && ditto -c -k --keepParent dist/CitizenCall-darwin-arm64/CitizenCall.app dist/CitizenCall-macos-arm64.zip",
    "dist:dmg": "hdiutil create -volname \"CitizenCall\" -srcfolder dist/CitizenCall-darwin-arm64/CitizenCall.app -ov -format UDZO dist/CitizenCall.dmg"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^33.2.0"
  }
}
